        { "tool_call": { "name": "find_free_time", "args": { "duration_minutes": 30, "from": "2026-11-09T09:00:00.000Z", "to": "2026-11-09T18:00:00.000Z" } } },
        { "tool_call": { "name": "propose_blocks", "args": { "blocks": [
